CT_CONFIG_VERSION="4"
CT_OBSOLETE=y
CT_EXPERIMENTAL=y
CT_STRIP_TARGET_TOOLCHAIN_EXECUTABLES=y
CT_ARCH_ARM=y
CT_ARCH_CPU="cortex-a9"
CT_ARCH_ARM_MODE_THUMB=y
CT_ARCH_FPU="neon"
CT_ARCH_FLOAT_HW=y
CT_TOOLCHAIN_PKGVERSION="NiLuJe"
CT_TARGET_VENDOR="kobov5"
CT_KERNEL_LINUX=y
CT_LINUX_V_4_9=y
CT_BINUTILS_LINKER_LD_GOLD=y
CT_BINUTILS_GOLD_THREADS=y
CT_BINUTILS_LD_WRAPPER=y
CT_BINUTILS_PLUGINS=y
CT_GLIBC_V_2_35=y
CT_GLIBC_EXTRA_CONFIG_ARRAY="--disable-crypt"
CT_GLIBC_EXTRA_CFLAGS="-Wno-missing-attributes -Wno-array-bounds -Wno-array-parameter -Wno-stringop-overflow -Wno-maybe-uninitialized"
CT_GLIBC_KERNEL_VERSION_CHOSEN=y
CT_GLIBC_MIN_KERNEL_VERSION="4.9"
CT_GLIBC_ENABLE_COMMON_FLAG=y
# CT_CC_GCC_STATIC_LIBSTDCXX is not set
# CT_CC_GCC_USE_GRAPHITE is not set
# CT_CC_GCC_ENABLE_TARGET_OPTSPACE is not set
CT_CC_GCC_LNK_HASH_STYLE_GNU=y
CT_CC_LANG_CXX=y
